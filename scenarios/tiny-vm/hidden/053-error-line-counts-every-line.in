; A runtime error reports the line of the instruction that failed, counting every
; line of the input: comments, blank lines and label-only lines included.

start:
        push 6
        call half

        push 7
        call half
        halt

half:   ; returns n div 2 after checking that n is even
        dup
        push 2
        mod
        jnz odd
        push 2
        div
        print
        ret
odd:
        push 0
        push 0
        div             ; fails here
