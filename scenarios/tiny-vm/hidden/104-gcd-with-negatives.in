next:   read
        dup
        jz stop
        read
        call gcd
        print
        jmp next
stop:   halt
; gcd(a, b) = b == 0 ? a : gcd(b, a mod b), printing each remainder
gcd:    dup
        jz done
        swap
        over
        mod
        dup
        print
        call gcd
        ret
done:   drop
        ret
.input
